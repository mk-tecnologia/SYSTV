# Referência de produção. O instalador gera /etc/systv/systv.env com segredos aleatórios.
NODE_ENV=production
HOST=127.0.0.1
PORT=3000
PUBLIC_ORIGIN=https://tv.exemplo.com.br
COOKIE_SECURE=true
# O primeiro administrador define usuário/senha pelo link de ativação.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=systv
DB_USER=systv
DB_PASSWORD=
DB_POOL_SIZE=10

# Chave AES-256 para as credenciais SMTP. Gere com: openssl rand -hex 32
MAIL_ENCRYPTION_KEY=
